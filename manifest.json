{
    "manifest_version": 3,
    "name": "Virtual Keyboard",
    "version": "1.0",
    "description": "A virtual keyboard to type in active tab.",
    "permissions": ["tabs"],
    "action": {
        "default_popup": "launcher.html",
      "default_icon": {
        "16": "/icons/icon.png",
        "48": "/icons/icon.png",
        "128": "/icons/icon.png"
      }
    },
    "web_accessible_resources": [
      {
        "resources": ["index.html"],
        "matches": ["<all_urls>"]
      }
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_end",
        "all_frames": true
      }
    ],
    "background": {
      "service_worker": "background.js"
    },
    "icons": {
      "16": "/icons/icon.png",
      "48": "/icons/icon.png",
      "128": "/icons/icon.png"
    }
  }
  