{
    "manifest_version": 3,
    "name": "Virtual Keyboard",
    "version": "1.0",
    "description": "A virtual keyboard to type in active tab.",
    "permissions": ["activeTab"],
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "/icons/icon.png",
            "48": "/icons/icon.png",
            "128": "/icons/icon.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "/icons/icon.png",
        "48": "/icons/icon.png",
        "128": "/icons/icon.png"
    }
}
